
{
  "name": "markcraft-studio",
  "version": "1.2.0",
  "description": "Professional vector logo and brand identity studio. Complete desktop application with PDF brand books and optional AI.",
  "main": "src/main/main.js",
  "author": "Bravo Projects",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir",
    "pack": "electron-builder --win dir",
    "postinstall": "echo Ready. Run npm start"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "pdf-lib": "^1.17.1",
    "paper": "^0.12.17"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.bravoprojects.markcraftstudio",
    "productName": "Markcraft Studio",
    "copyright": "Copyright © Bravo Projects",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "docs/**/*",
      "node_modules/pdf-lib/**/*",
      "node_modules/paper/**/*",
      "node_modules/electron-store/**/*",
      "node_modules/conf/**/*",
      "node_modules/ajv/**/*",
      "node_modules/json-schema-traverse/**/*",
      "node_modules/require-from-string/**/*",
      "node_modules/atomically/**/*",
      "node_modules/dot-prop/**/*",
      "node_modules/env-paths/**/*",
      "node_modules/debounce-fn/**/*",
      "node_modules/semver/**/*",
      "node_modules/type-fest/**/*",
      "node_modules/mimic-fn/**/*",
      "node_modules/onetime/**/*",
      "node_modules/pkg-up/**/*",
      "node_modules/find-up/**/*",
      "node_modules/locate-path/**/*",
      "node_modules/p-locate/**/*",
      "node_modules/p-limit/**/*",
      "node_modules/yocto-queue/**/*",
      "node_modules/path-exists/**/*",
      "node_modules/p-try/**/*"
    ],
    "win": {
      "icon": "assets/logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "artifactName": "Markcraft-Studio-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Markcraft Studio",
      "uninstallDisplayName": "Markcraft Studio"
    },
    "portable": {
      "artifactName": "Markcraft-Studio-Portable-${version}.${ext}"
    }
  }
}
